{
  "name": "deepseek-chat-max",
  "version": "0.1.1",
  "description": "Local-first, pluggable DeepSeek chat client with local SQLite storage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebExperiments-glitch/deepseek-chat-max.git"
  },
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "dev:server": "node --watch server/index.mjs",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "node scripts/build.mjs",
    "build:static": "node scripts/build.mjs --static",
    "build:wasm": "node scripts/build-wasm.mjs",
    "verify:wasm": "node scripts/verify-zip-wasm.mjs",
    "verify:batch": "node scripts/verify-batch-import.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "node --test scripts/verify-server-db.mjs scripts/verify-server-security.mjs",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "katex": "0.19.1",
    "mdast-util-find-and-replace": "3.0.4",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.3.3",
    "@rspack/core": "2.3.3",
    "@rspack/dev-server": "2.2.2",
    "@swc/helpers": "0.5.24",
    "@types/node": "~20.19.43",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "lodash-es": "4.18.0"
    }
  }
}
