#!/bin/sh
# ============================================================
# pre-push —— 本地最后一道闸门
# ============================================================
# 安装：git config core.hooksPath .githooks
# 绕过：git push --no-verify（不推荐；CI 的 audit + 分支保护仍会拦）
# ============================================================
set -e
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] 1/2 静态审计 review-gate ..."
node scripts/review-gate.mjs

echo "[pre-push] 2/2 全质量门 type/lint/test/test:server/build ..."
pnpm type
pnpm lint
pnpm test
pnpm test:server
pnpm build

echo "[pre-push] 全部通过。"
